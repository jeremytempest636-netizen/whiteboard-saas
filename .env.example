# Copy to .env and change every secret before deploying.
POSTGRES_USER=whiteboard
POSTGRES_PASSWORD=change-me-primary
POSTGRES_REPLICATION_PASSWORD=change-me-replication
POSTGRES_DB=whiteboard

# At least 32 characters. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string-0123456789

# Browser origin(s) allowed to call the API, comma separated.
ALLOWED_ORIGINS=http://localhost:3000

# Public URLs the browser uses to reach the API (through the nginx balancer).
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
